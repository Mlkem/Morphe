{
  "branches": [
    "main",
    {
      "name": "dev",
      "prerelease": true
    }
  ],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "releaseRules": [
          {
            "breaking": true,
            "release": "major"
          },
          {
            "type": "fix",
            "release": "patch"
          },
          {
            "type": "feat",
            "release": "minor"
          },
          {
            "type": "bump",
            "release": "patch"
          },
          {
            "type": "perf",
            "release": "patch"
          },
          {
            "type": "build",
            "scope": "Needs bump",
            "release": "patch"
          }
        ]
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits",
        "presetConfig": {
          "types": [
            {
              "type": "feat",
              "section": "\u2728 New Features",
              "hidden": false
            },
            {
              "type": "perf",
              "section": "\ud83d\udd27 Improvements",
              "hidden": false
            },
            {
              "type": "fix",
              "section": "\ud83d\udc1b Bug Fixes",
              "hidden": false
            },
            {
              "type": "bump",
              "section": "\ud83d\ude80 Updated App Support",
              "hidden": false
            },
            {
              "type": "build",
              "hidden": true
            }
          ]
        }
      }
    ],
    [
      "@MorpheApp/changelog",
      {
        "releaseJson": {
          "path": "patches-bundle.json",
          "downloadUrlTemplate": "https://github.com/${owner}/${repo}/releases/download/v${version}/patches-${version}.mpp",
          "signatureUrlTemplate": "",
          "publicKeyPath": "morphe-signing.pub"
        }
      }
    ],
    "gradle-semantic-release-plugin",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "./gradlew :patches:buildAndroid :patches:generatePatchesList --no-daemon && python3 scripts/verify_bundle.py && python3 .github/scripts/generate_patches_readme.py Mlkem/Morphe dev patches-list.json README.md && python3 scripts/updates/catalog.py --release"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "CHANGELOG.md",
          "gradle.properties",
          "patches-bundle.json",
          "patches-list.json",
          "README.md",
          "updates/app-feed.json"
        ],
        "message": "chore: Release v${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "patches/build/libs/patches-!(*sources*|*javadoc*).mpp?(.asc)"
          }
        ],
        "successCommentCondition": false,
        "failCommentCondition": false,
        "releasedLabels": false
      }
    ]
  ]
}
